# Telegram Bot API credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=your_phone_number_optional

# Telethon session string (generated via scripts/generate_session.py for GitHub Actions)
TELETHON_SESSION_STRING=

# Supabase REST API (used by supabase-py)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Direct Database Connection (used for migrations and direct Postgres tools)
# Note: Special characters in password must be percent-encoded (e.g. * -> %2A, + -> %2B, ! -> %21, & -> %26)
SUPABASE_DB_URL=postgresql://postgres:encoded_password@db.your-project-ref.supabase.co:5432/postgres

# Webhook configuration (for serverless bot endpoint)
WEBHOOK_URL=https://your-domain.vercel.app/api/webhook
WEBHOOK_SECRET=your_custom_webhook_secret_token
